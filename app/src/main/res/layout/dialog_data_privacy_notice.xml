<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pin_dot_empty" />

    <!-- Header Section with Shield -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_auth_avatar_circle"
            android:backgroundTint="#DCFCE7">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="REPUBLIC ACT NO. 10173"
                android:textColor="#155EC4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Data Privacy Act of 2012"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="ICCT Colleges Foundation Inc. • E-ReQuest"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E9EEF4" />

    <!-- Scrollable Content of the Privacy Notice -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrivacyPolicy"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Section 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Policy Commitment"
                android:textColor="@color/primary_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="In compliance with Republic Act No. 10173, otherwise known as the Data Privacy Act of 2012 (DPA), ICCT Colleges Foundation Inc. is dedicated to protecting your fundamental right to privacy while processing personal data through the E-ReQuest application system."
                android:textColor="#344054"
                android:textSize="12.5sp" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="2. Personal Data Collected"
                android:textColor="@color/primary_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="During student registration, the following specific personal data elements are collected:\n• Student ID Number: Campus code, enrollment year, and 5-digit number (e.g., CA-2023-02087)\n• Official Email Address: For sending 6-digit One-Time Password (OTP) verification codes and security notifications\n• 4-Digit Access PIN: Securely hashed via SHA-256 with a unique random salt (raw PIN is never saved or transmitted)\n• Device Information: Device model, Android OS version, and installation ID strictly used to prevent account abuse and enforce the 3-accounts-per-device safety policy."
                android:textColor="#344054"
                android:textSize="12.5sp" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="3. Purpose &amp; Processing"
                android:textColor="@color/primary_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Your data is processed solely for:\n• Authenticating student identity and providing access to academic transaction guidelines and requirements checklists\n• Enabling offline authentication mode with secure local credentials\n• Protecting student records from unauthorized account takeovers and automated fraudulent activity."
                android:textColor="#344054"
                android:textSize="12.5sp" />

            <!-- Section 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="4. Security &amp; Storage"
                android:textColor="@color/primary_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="All sensitive data on your device is encrypted using Android Keystore / AES encryption. Remote data is protected by Google Cloud Firestore security rules. Your personal information will NEVER be shared, sold, or distributed to any unauthorized commercial third party."
                android:textColor="#344054"
                android:textSize="12.5sp" />

            <!-- Section 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="5. Student Rights under RA 10173"
                android:textColor="@color/primary_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Under the Data Privacy Act of 2012, you have the right to be informed, to access, to object, to correct inaccuracies, and to lodge a complaint regarding the processing of your personal information."
                android:textColor="#344054"
                android:textSize="12.5sp" />

            <!-- Consent Declaration Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_privacy_consent_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consent Declaration"
                    android:textColor="@color/primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="By tapping 'I Agree &amp; Accept', you freely and explicitly give your consent to ICCT Colleges Foundation Inc. to collect, process, and securely store your personal information for E-ReQuest academic transactions in full compliance with Republic Act No. 10173."
                    android:textColor="#102A3E"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E9EEF4" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcceptDataPrivacy"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="I Agree &amp; Accept"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/btnDeclineDataPrivacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="Decline / Go Back"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
