<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".TransactionDetailsActivity">

    <!-- ================================================= -->
    <!-- HEADER BACKGROUND LAYERS (Strictly inside header container bounds) -->
    <!-- ================================================= -->

    <!-- Base Solid Dark Navy Layer -->
    <View
        android:id="@+id/vDetailsHeaderBase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="@id/detailsHeader"
        app:layout_constraintBottom_toBottomOf="@id/detailsHeader"
        app:layout_constraintStart_toStartOf="@id/detailsHeader"
        app:layout_constraintEnd_toEndOf="@id/detailsHeader" />

    <!-- Campus Background Photograph adjusted for compact header at 75% opacity -->
    <ImageView
        android:id="@+id/ivDetailsHeaderCampusBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_header_campus_compact"
        android:scaleType="centerCrop"
        android:alpha="0.75"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/detailsHeader"
        app:layout_constraintBottom_toBottomOf="@id/detailsHeader"
        app:layout_constraintStart_toStartOf="@id/detailsHeader"
        app:layout_constraintEnd_toEndOf="@id/detailsHeader" />

    <!-- Dark Blue Gradient Overlay placed directly over the image before text renders -->
    <View
        android:id="@+id/vDetailsHeaderOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_gradient_overlay"
        app:layout_constraintTop_toTopOf="@id/detailsHeader"
        app:layout_constraintBottom_toBottomOf="@id/detailsHeader"
        app:layout_constraintStart_toStartOf="@id/detailsHeader"
        app:layout_constraintEnd_toEndOf="@id/detailsHeader" />

    <!-- Details Header Content LinearLayout (Clean, safe-area padded, natural wrap_content) -->
    <LinearLayout
        android:id="@+id/detailsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_white"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Getting Prospectus"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:text="Registrar Services"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- REFRESH BUTTON -->
        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Refresh"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_white" />

    </LinearLayout>


    <!-- CONTENT -->
    <ScrollView
        android:id="@+id/detailsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/detailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- ABOUT TRANSACTION -->
            <LinearLayout
                android:id="@+id/sectionAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About this Transaction"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="View the information, requirements, and procedure needed to complete this transaction."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- REQUIREMENTS -->
            <LinearLayout
                android:id="@+id/sectionRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requirements"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/requirementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>


            <!-- STEP-BY-STEP PROCEDURE -->
            <LinearLayout
                android:id="@+id/sectionProcedure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step-by-Step Procedure"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/stepsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>


            <!-- OFFICE INFORMATION -->
            <LinearLayout
                android:id="@+id/sectionOfficeInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Office Information"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOffice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Registrar's Office"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- OFFICE SCHEDULE -->
            <LinearLayout
                android:id="@+id/sectionOfficeSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Office Schedule"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Schedule will be provided by the administrator."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- DEPARTMENT GUIDELINES -->
            <LinearLayout
                android:id="@+id/sectionDepartmentGuidelines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_reminder"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Department Guidelines"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/departmentGuidelinesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>


            <!-- REQUIREMENT CHECKLIST -->
            <Button
                android:id="@+id/btnStartChecklist"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/primary"
                android:text="Check Requirement Checklist"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>