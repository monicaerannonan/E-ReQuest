<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/servicesMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ServicesActivity">

    <!-- Header Base Background Color -->
    <View
        android:id="@+id/vServicesHeaderBase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="@id/servicesHeader"
        app:layout_constraintBottom_toBottomOf="@id/servicesHeader"
        app:layout_constraintStart_toStartOf="@id/servicesHeader"
        app:layout_constraintEnd_toEndOf="@id/servicesHeader" />

    <!-- Campus Background Photograph adjusted for compact header at 75% opacity -->
    <ImageView
        android:id="@+id/ivServicesHeaderCampusBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_header_campus_compact"
        android:scaleType="centerCrop"
        android:alpha="0.75"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/servicesHeader"
        app:layout_constraintBottom_toBottomOf="@id/servicesHeader"
        app:layout_constraintStart_toStartOf="@id/servicesHeader"
        app:layout_constraintEnd_toEndOf="@id/servicesHeader" />

    <!-- Dark Blue Gradient Overlay placed directly over the image before text renders -->
    <View
        android:id="@+id/vServicesHeaderOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_gradient_overlay"
        app:layout_constraintTop_toTopOf="@id/servicesHeader"
        app:layout_constraintBottom_toBottomOf="@id/servicesHeader"
        app:layout_constraintStart_toStartOf="@id/servicesHeader"
        app:layout_constraintEnd_toEndOf="@id/servicesHeader" />

    <!-- Services Header Content LinearLayout (Clean, safe-area padded, natural wrap_content) -->
    <LinearLayout
        android:id="@+id/servicesHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School Services"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:text="Select the service you need"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Refresh"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/servicesSectionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/servicesHeader">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Services"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose a school service to view its available transactions."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/servicesSectionHeader"
        tools:listitem="@layout/item_school_service" />

    <TextView
        android:id="@+id/tvNoServices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="No school services available."
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/servicesSectionHeader" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Inactive Tab: Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_nav_home_inactive" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="@color/nav_inactive"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Active Tab: Services -->
        <LinearLayout
            android:id="@+id/navServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/bg_nav_pill_active">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Services"
                    android:src="@drawable/ic_nav_services_active" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Services"
                android:textColor="@color/nav_active_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Inactive Tab: Progress -->
        <LinearLayout
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Progress"
                    android:src="@drawable/ic_nav_progress_inactive" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Progress"
                android:textColor="@color/nav_inactive"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
