<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studentAuthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    tools:context=".features.auth.StudentAuthActivity">

    <!-- ========================================================= -->
    <!-- MODE 1: UNIVERSITY PORTAL RETURNING LOGIN                 -->
    <!-- (Top Hero Campus Picture + Docked Soft Gray Bottom Sheet) -->
    <!-- ========================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutReturningGcashStyle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Top Campus Photo (CONFINED EXCLUSIVELY TO TOP HERO REGION ABOVE BOTTOM SHEET) -->
        <ImageView
            android:id="@+id/ivAuthBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.72"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_auth_campus"
            app:layout_constraintBottom_toTopOf="@id/panelBottomLoginSheet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top Dark Gradient Overlay (Lightened at bottom to showcase entrance) -->
        <View
            android:id="@+id/vAuthOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_auth_campus_overlay"
            app:layout_constraintBottom_toTopOf="@id/panelBottomLoginSheet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TOP BRAND: Logo + E-ReQuest + Tagline over Sky/Campus -->
        <LinearLayout
            android:id="@+id/layoutTopBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivAuthLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_logo_circle"
                android:clipToOutline="true"
                android:contentDescription="@string/app_name"
                android:elevation="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_erequest_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.02"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuthBrandSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:shadowColor="#55000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/app_tagline"
                android:textColor="#E6EFF8"
                android:textSize="13.5sp" />

            <!-- Subtle Connectivity Status Pill in Hero Area when Offline -->
            <TextView
                android:id="@+id/tvAuthOfflineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_splash_offline_pill"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="Offline Mode • 4-Digit PIN Ready"
                android:textColor="#E2ECF5"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- BOTTOM PANEL: 100% Solid Opacity Soft Gray (#EFF3F7) Flat Flush University Portal Login Panel -->
        <LinearLayout
            android:id="@+id/panelBottomLoginSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_bottom_sheet"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Greeting Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Welcome Back, Student!"
                android:textColor="#102A3E"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Active Student ID Selector Card (Crisp White Card over Gray Panel) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStudentNumberPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:rippleColor="#1F173B57"
                app:strokeColor="#D4DFEA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="13dp">

                    <!-- Student ID Badge Icon -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_student_id_icon_box">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_header_student_id"
                            app:tint="#173B57" />
                    </FrameLayout>

                    <!-- Active Student ID Label + Number -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvActiveStudentLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="ACTIVE STUDENT ID"
                            android:textColor="#667085"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveStudentNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:letterSpacing="0.03"
                            android:singleLine="true"
                            android:text="CA-2026-00000"
                            android:textColor="#102A3E"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Soft Navy Change Button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_account_change_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="11dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp">

                        <ImageView
                            android:id="@+id/ivSwitchArrows"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Change Account"
                            android:src="@drawable/ic_switch_arrows"
                            app:tint="#173B57" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Change"
                            android:textColor="#173B57"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Full-Width Primary Button: Unlock with 4-Digit PIN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPinLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#173B57"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:rippleColor="#33FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Unlock with 4-Digit PIN"
                        android:src="@drawable/ic_pin_lock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="0.02"
                        android:text="Unlock with 4-Digit PIN"
                        android:textColor="#FFFFFF"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Row: ONLY Forgot PIN? • v1.0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvForgotPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Forgot PIN?"
                    android:textColor="#173B57"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    android:text="•"
                    android:textColor="#98A2B3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAuthVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:text="v1.0"
                    android:textColor="#667085"
                    android:textSize="12.5sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- MODE 2: REGISTRATION / ADD ACCOUNT / OTP / PIN SETUP      -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/scrollEnrollmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="52dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

            <!-- Brand Mini Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_logo_circle"
                    android:clipToOutline="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_erequest_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Student Portal Verification"
                android:textColor="#CBD7E2"
                android:textSize="13sp" />

            <!-- Back to Quick PIN Screen (Shown when adding 2nd/3rd account) -->
            <TextView
                android:id="@+id/btnBackToQuickLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_splash_offline_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="← Back to PIN Login"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- White Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_auth_glass_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- ============================================= -->
                <!-- SUB-STEP 1: STUDENT NUMBER + EMAIL INPUT      -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/stepStudentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Mode Tabs: Register vs Existing Account -->
                    <LinearLayout
                        android:id="@+id/layoutAuthModeTabs"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_auth_input_field"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/tabRegister"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_nav_pill_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Register"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabExistingAccount"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Existing Account"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEnrollmentSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Select Campus and Year, enter your 5-digit number and Email Address to receive an OTP."
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <!-- Student Number Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Student Number"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- [Campus Dropdown] - [Year Dropdown] - [5-Digit Input] -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Dropdown 1: AU, BI, CA, CO, SA, SU, TA, XX -->
                        <LinearLayout
                            android:id="@+id/btnSelectCampus"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="0.95"
                            android:background="@drawable/bg_auth_input_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <TextView
                                android:id="@+id/tvSelectedCampus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="AU"
                                android:textColor="#102A3E"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dropdown_chevron" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:text="-"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Dropdown 2: Year 2000 .. 2040 -->
                        <LinearLayout
                            android:id="@+id/btnSelectYear"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.18"
                            android:background="@drawable/bg_auth_input_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <TextView
                                android:id="@+id/tvSelectedYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="2026"
                                android:textColor="#102A3E"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dropdown_chevron" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:text="-"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Empty Blank Space: 5-Digit Number Only -->
                        <EditText
                            android:id="@+id/etStudentDigits"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.32"
                            android:background="@drawable/bg_auth_input_field"
                            android:digits="0123456789"
                            android:gravity="center"
                            android:hint="00000"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:letterSpacing="0.06"
                            android:maxLength="5"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:singleLine="true"
                            android:textColor="#102A3E"
                            android:textColorHint="#98A2B3"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Live Student Number Preview -->
                    <TextView
                        android:id="@+id/tvStudentNumberPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Format: AU-2026-00000"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Email Address Input (Shown in Register Mode) -->
                    <LinearLayout
                        android:id="@+id/layoutEmailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Address"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etStudentEmail"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_auth_input_field"
                            android:autofillHints="emailAddress"
                            android:hint="student@email.com"
                            android:importantForAutofill="yes"
                            android:inputType="textEmailAddress"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Data Privacy Act of 2012 (RA 10173) Agreement Row (Register Mode Only) -->
                    <LinearLayout
                        android:id="@+id/layoutDataPrivacyConsentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbDataPrivacyConsent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:buttonTint="@color/selector_checkbox_privacy" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDataPrivacyConsentLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="2dp"
                                android:text="I have read and agree to the Data Privacy Act of 2012 (RA 10173)."
                                android:textColor="#102A3E"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/btnViewDataPrivacyNotice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="Read Privacy Notice →"
                                android:textColor="#155EC4"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Option B Daily Slot Indicator -->
                    <TextView
                        android:id="@+id/tvDailySlotStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Accounts on this device: 0 / 3"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOtp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Send OTP to Email"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- ============================================= -->
                <!-- SUB-STEP 2: 6-DIGIT EMAIL OTP VERIFICATION    -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/stepOtpVerification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify Email OTP"
                        android:textColor="@color/primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOtpSentInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="We have sent a 6-digit OTP to your email."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Dev/Testing OTP Preview Banner (auto-hidden once Gmail SMTP is configured) -->
                    <LinearLayout
                        android:id="@+id/cardDevOtpBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_reminder"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEV / TESTING OTP PREVIEW (No SMTP configured yet)"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDevOtpCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.18"
                            android:text="000000"
                            android:textColor="@color/primary_dark"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap this banner to auto-fill code"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etOtpCode"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_auth_input_field"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:hint="000000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:letterSpacing="0.28"
                        android:maxLength="6"
                        android:singleLine="true"
                        android:textColor="@color/primary_dark"
                        android:textColorHint="@color/text_hint"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Verify OTP"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnChangeStudentDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="← Edit Details"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnResendOtp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="Resend OTP"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================= -->
                <!-- SUB-STEP 3: CREATE / RESET 4-DIGIT PIN        -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/stepPinSetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPinSetupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create 4-Digit PIN"
                        android:textColor="@color/primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPinSetupSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="You will use this 4-digit PIN to open E-ReQuest even without an internet connection (Offline Mode)."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="New 4-Digit PIN"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNewPin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_auth_input_field"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:hint="••••"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:letterSpacing="0.35"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textColor="@color/primary_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Confirm 4-Digit PIN"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etConfirmPin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_auth_input_field"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:hint="••••"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:letterSpacing="0.35"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textColor="@color/primary_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="Save 4-Digit PIN &amp; Login"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Inline Progress Indicator -->
                <ProgressBar
                    android:id="@+id/progressAuthAction"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
