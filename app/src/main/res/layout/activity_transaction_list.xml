<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transactionListMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".TransactionListActivity">

    <!-- Header Base Background Color -->
    <View
        android:id="@+id/vTransactionHeaderBase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="@id/transactionHeader"
        app:layout_constraintBottom_toBottomOf="@id/transactionHeader"
        app:layout_constraintStart_toStartOf="@id/transactionHeader"
        app:layout_constraintEnd_toEndOf="@id/transactionHeader" />

    <!-- Campus Background Photograph adjusted for compact header at 75% opacity -->
    <ImageView
        android:id="@+id/ivTransactionHeaderCampusBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_header_campus_compact"
        android:scaleType="centerCrop"
        android:alpha="0.75"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/transactionHeader"
        app:layout_constraintBottom_toBottomOf="@id/transactionHeader"
        app:layout_constraintStart_toStartOf="@id/transactionHeader"
        app:layout_constraintEnd_toEndOf="@id/transactionHeader" />

    <!-- Dark Blue Gradient Overlay placed directly over the image before text renders -->
    <View
        android:id="@+id/vTransactionHeaderOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_gradient_overlay"
        app:layout_constraintTop_toTopOf="@id/transactionHeader"
        app:layout_constraintBottom_toBottomOf="@id/transactionHeader"
        app:layout_constraintStart_toStartOf="@id/transactionHeader"
        app:layout_constraintEnd_toEndOf="@id/transactionHeader" />

    <!-- Transaction Header Content LinearLayout (Clean, prominent title, safe-area padded, natural wrap_content) -->
    <LinearLayout
        android:id="@+id/transactionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_white"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School Service"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:text="Select a transaction"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Refresh"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/transactionSectionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transactionHeader">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Transactions"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose the transaction you need."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transactionSectionHeader"
        tools:listitem="@layout/item_transaction" />

    <TextView
        android:id="@+id/tvNoTransactions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="36dp"
        android:text="No transactions available."
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transactionSectionHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
